{
  "name": "diary-word-battle",
  "version": "0.17.3",
  "description": "그림일기 단어 조립 전투 — a picture-diary sentence-combat roguelite",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "assets:optimize": "tsx scripts/optimize-assets.ts",
    "assets:check": "tsx scripts/optimize-assets.ts --check",
    "characters:check": "tsx scripts/check-character-assets.ts",
    "resources:check": "tsx src/tools/resource-lifecycle-check.ts",
    "experience:check": "tsx scripts/check-experience-contracts.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "predev": "npm run assets:optimize",
    "prebuild": "npm run assets:optimize",
    "prebuild:demo": "npm run assets:optimize",
    "data:generate": "tsx scripts/generate-sentence-data.ts",
    "clip:beats": "tsx scripts/clip-beats.ts",
    "sprites:bake": "node scripts/bake-slash-sprites.mjs",
    "dev": "npm run data:generate && vite",
    "build": "npm run data:generate && npm run assets:check && npm run characters:check && npm run resources:check && npm run experience:check && tsc && vite build && npm run bundle:check -- --edition=full",
    "build:demo": "npm run data:generate && npm run assets:check && npm run characters:check && npm run resources:check && npm run experience:check && tsc && vite build --mode demo --outDir ../dist-demo && npm run bundle:check -- --dist=dist-demo --edition=demo",
    "preview": "vite preview",
    "web:check": "tsx scripts/check-web-delivery.ts",
    "web:serve": "vite preview --host 127.0.0.1 --port 8000",
    "web:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-web-build.ps1",
    "type-check": "npm run data:generate && tsc --noEmit",
    "steering:check": "tsx src/tools/steering-check.ts",
    "sweep": "npm run data:generate && tsx src/tools/sweep.ts",
    "locale:check": "npm run data:generate && tsx src/tools/locale-check.ts",
    "check": "npm run data:generate && tsx src/tools/check-tables.ts",
    "effects:check": "npm run data:generate && tsx src/tools/combat-effects-check.ts",
    "core:check": "npm run data:generate && tsx src/tools/core-contract-check.ts",
    "emotion:check": "npm run data:generate && tsx src/tools/emotion-balance-check.ts",
    "items:check": "npm run data:generate && tsx src/tools/item-balance-check.ts",
    "balance:check": "npm run data:generate && tsx src/tools/run-sim.ts --runs=24 --check",
    "boss:sim": "npm run data:generate && tsx src/tools/boss-sim.ts",
    "run:sim": "npm run data:generate && tsx src/tools/run-sim.ts",
    "release:check": "tsx scripts/release-check.ts",
    "test": "npm run type-check && npm run sweep && npm run check && npm run locale:check && npm run effects:check && npm run core:check && npm run emotion:check && npm run items:check && npm run characters:check && npm run experience:check && npm run mind:check && npm run policy:sim && npm run boss:sim && npm run balance:check",
    "mind:check": "npm run data:generate && tsx src/tools/token-mind-check.ts",
    "policy:sim": "npm run data:generate && tsx src/tools/token-policy-sim.ts",
    "integrated:check": "tsx src/tools/integrated-steering-check.ts",
    "integrated:sim": "tsx src/tools/integrated-opening-sim.ts"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.1.1",
    "@types/three": "^0.179.0",
    "lightningcss": "^1.33.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.179.1"
  }
}
